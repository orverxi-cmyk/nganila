GEMINI_API_KEY=your_gemini_api_key_here
MASTER_ADMIN_EMAIL=orverxi@gmail.com

# ============================================================
# ZOHO CPAAS REST API (Recommended Primary Email Engine)
# ============================================================
# Official Documentation: https://www.zoho.com/cpaas/help/api/email-sending.html
# Host: cpaas.zoho.com
# Endpoint: https://cpaas.zoho.com/v1.1/email
# Auth Header: Authorization: Zoho-enczapikey {apiKey}
# Agent Alias: 7c6dc6fcbb934ccb
# Verified Domain: sanex.rw
#
# 1. ZOHO_CPAAS_SEND_MAIL_TOKEN:
#    Paste your API key here (e.g. Zoho-enczapikey ******** or raw token).
# 2. ZOHO_CPAAS_FROM_EMAIL:
#    Must be an address on your verified domain @sanex.rw (e.g. info@sanex.rw or dispatch@sanex.rw).
# 3. ZOHO_CPAAS_FROM_NAME:
#    Display name shown to recipients (e.g. "SANEX Company Ltd").
# 4. ZOHO_CPAAS_AGENT_ALIAS:
#    Your Zoho CPaaS Agent Alias (7c6dc6fcbb934ccb).
# ============================================================
ZOHO_CPAAS_SEND_MAIL_TOKEN=your_zoho_cpaas_api_key_here
ZOHO_CPAAS_API_URL=https://cpaas.zoho.com/v1.1/email
ZOHO_CPAAS_FROM_EMAIL=info@sanex.rw
ZOHO_CPAAS_FROM_NAME="SANEX Company Ltd"
ZOHO_CPAAS_AGENT_ALIAS=7c6dc6fcbb934ccb

# Optional Secret Key for server-to-server calls / API test automation (min 16 chars)
ADMIN_API_SECRET=your_secure_admin_api_secret_here

# ============================================================
# ZOHO CPAAS / ZEPTOMAIL SMTP RELAY (Alternative or SMTP Fallback)
# ============================================================
# Server name: smtp.zeptomail.com
# Port: 587 (TLS) or 465 (SSL)
# Username: emailapikey
# Password: your Zoho CPaaS API key
# ============================================================
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASS=your_zoho_cpaas_api_key_here
EMAIL_FROM="SANEX Company Ltd" <info@sanex.rw>
COMPANY_EMAIL=info@sanex.rw

# Mailchimp Newsletter Integration
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_AUDIENCE_ID=your_mailchimp_audience_id
MAILCHIMP_API_SERVER=us21
